{
  "name": "little-days",
  "version": "0.1.0",
  "description": "小日子 · 本地生活手账",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/electron.cjs",
    "test:dev": "node tests/dev.cjs",
    "pack:win": "vue-tsc --noEmit && electron-vite build && electron-builder --win --x64 --dir",
    "dist:win": "vue-tsc --noEmit && electron-vite build && electron-builder --win nsis --x64",
    "dist:mac": "vue-tsc --noEmit && electron-vite build && electron-builder --mac dmg"
  },
  "dependencies": { "vue": "^3.5.0" },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "3.3.11"
  },
  "overrides": { "app-builder-lib": { "@electron/get": "4.0.3" } },
  "build": {
    "appId": "local.littledays.journal",
    "productName": "Little Days",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "asar": true,
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false },
    "mac": { "target": "dmg", "category": "public.app-category.lifestyle" }
  }
}
